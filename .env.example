# Optional: SQLite works without an .env file.
SQLITE_PATH=data/perfume.sqlite
# Optional CLI owner seeding/recovery. You can create the first owner in the app instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production server options (npm start)
HOST=127.0.0.1
PORT=4173
# Enable only when serving over HTTPS.
COOKIE_SECURE=false

# Firebase disabled while using SQLite:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
